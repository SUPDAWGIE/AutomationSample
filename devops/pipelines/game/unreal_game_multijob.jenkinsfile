def ColorFromBuildResult(result){
    if("${result}" == 'SUCCESS') return '#18A558'
    if("${result}" == 'ABORTED') return '#6e6e6e'
    if("${result}" == 'UNSTABLE') return '#fcba03'
    return '#FF0000'
}

pipeline {
    agent none

    /* environment {
        SLACK_CHANNEL = 'tps-game-builds'
    }*/
    stages {
        stage('Game test') {
            steps {
                slackSend channel: "$SLACK_CHANNEL",
                    color: "$currentBuild.previousBuild" == 'null' ? '#18A558' :
                    ColorFromBuildResult("$currentBuild.previousBuild.result"),
                    message:"Build started: ${env.JOB_NAME} #${env.BUILD_NUMBER} (<${env.BUILD_URL}|Open>)"

                build job: 'AutomationSample-test-runner-pipeline', parameters: [string(name: 'BUILD_DIR', value: 'D:\\JenkinsJobs\\AutomationSample-TestRunner')]
            }
        }
        stage('Matrix') {
            matrix {
                agent {
                    node {
                        label "unreal_test_runner_label"
                    }
                }

                axes {
                    axis {
                        name 'CONFIG'
                        values 'Development', 'Shipping'
                    }
                }

                stages {
                    stage('Game build') {
                        steps {
                            build job: 'AutomationSample-target-build-pipeline', parameters: [string(name: 'BUILD_DIR', value: 'D:\\JenkinsJobs\\AutomationSample-Pipeline'), string(name: 'CONFIG', value: "$CONFIG")]
                        }
                    }
                }
            }
        }
        stage('Doxygen docs gen') {
            steps {
                build job: 'AutomationSample-doxygen-docs-pipeline', parameters: [string(name: 'BUILD_DIR', value: 'D:\\JenkinsJobs\\AutomationSample-Docs')]
            }
        }
    }

    post {
        always {
            slackSend channel: "$SLACK_CHANNEL",
                color: ColorFromBuildResult("$currentBuild.currentResult"),
                message:"Build $currentBuild.currentResult: ${env.JOB_NAME} #${env.BUILD_NUMBER} (<${env.BUILD_URL}|Open>)"
        }
    }
}
